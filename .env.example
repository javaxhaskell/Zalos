# AgentForge — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- LLM provider ---
# AUTHOR_MODEL_PROVIDER is accepted as an alias for LLM_PROVIDER.
# Use "deepseek" for API-backed Author runs (recommended — no local model runtime required).
# Use "ollama" for local runs. Use "anthropic" with ANTHROPIC_API_KEY for Claude.
LLM_PROVIDER=deepseek

# --- DeepSeek (when LLM_PROVIDER=deepseek) ---
DEEPSEEK_API_KEY=INSERT_DEEPSEEK_API_KEY_HERE
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_STRONG_MODEL=deepseek-v4-pro
AUTHOR_PLANNING_MODEL=deepseek-v4-pro
AUTHOR_REVIEW_MODEL=deepseek-v4-pro
AUTHOR_CODEGEN_MODEL=deepseek-v4-flash
AUTHOR_TESTGEN_MODEL=deepseek-v4-flash
AUTHOR_REPAIR_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=300
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_RETRIES=2

# Dev-only legacy shortcut for the bundled bank reference sample. Keep false
# for normal Author runs so planning/review/codegen/testgen are model-authored.
AUTHOR_ENABLE_BANK_REFERENCE_SCAFFOLD=false
# Token budget controls for small Author workflows (<=25 rows by default).
AUTHOR_MAX_REPAIR_ATTEMPTS=1
AUTHOR_SMALL_WORKFLOW_ROW_THRESHOLD=25
AUTHOR_COMPACT_CONTRACT_PROMPTS=true

# --- Ollama (optional — not required for DeepSeek API runs) ---
OLLAMA_BASE_URL=http://localhost:11434
# Default local model for agent-loop/repair calls and health checks.
OLLAMA_MODEL=qwen2.5-coder:14b
# Schema-heavy Author stages (contract planning/review/repair, JSON repair).
OLLAMA_PLANNING_MODEL=qwen2.5-coder:14b
# Python + pytest authoring stages.
OLLAMA_CODEGEN_MODEL=qwen2.5-coder:7b
OLLAMA_CODEGEN_TEMPERATURE=0.1
OLLAMA_NUM_CTX=12288
OLLAMA_PLANNING_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=900

# --- Anthropic (when LLM_PROVIDER=anthropic) ---
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# --- Database (SQLite for prototype) ---
DATABASE_URL=sqlite:///./.workspaces/agentforge.db

# --- Workspace ---
WORKSPACES_ROOT=./.workspaces
WORKSPACES_ARCHIVE_ROOT=./.workspaces-archive

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
# For alternate local ports, comma-separate trusted origins, for example:
# FRONTEND_ORIGIN=http://localhost:3100,http://127.0.0.1:3100

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Budgets (per session) ---
BUDGET_TOKENS=150000
BUDGET_TOOL_CALLS=40
BUDGET_STEPS_AUTHOR=25
BUDGET_STEPS_REPAIR=20
BUDGET_WALL_SECONDS=1500
BUDGET_FILE_UPLOAD_MAX_BYTES=26214400        # 25 MB
BUDGET_FILES_TOTAL_MAX_BYTES=104857600       # 100 MB
BUDGET_GENERATED_FILE_COUNT=20

# --- Subprocess sandbox ---
SUBPROCESS_TIMEOUT_SCRIPT=60
SUBPROCESS_TIMEOUT_PYTEST=120
SUBPROCESS_OUTPUT_MAX_BYTES=1048576          # 1 MiB per stream

# --- Demo identity (single-user prototype) ---
DEMO_USER_ID=user-demo
DEMO_USER_EMAIL=demo@agentforge.local
DEMO_USER_NAME="Demo Finance User"

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
