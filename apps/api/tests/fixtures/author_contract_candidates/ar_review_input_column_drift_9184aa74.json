    "exception_rules": [
      {
        "condition": "residual_balance > 0",
        "name": "requires_review",
        "output_column": "issue_flag",
        "reason": "Residual balance remains open after remittance application.",
        "severity": "warning"
      },
      {
        "condition": "residual_balance < 0",
