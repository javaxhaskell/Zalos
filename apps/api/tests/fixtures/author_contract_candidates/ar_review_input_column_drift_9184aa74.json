        ],
        "layer": "row_level",
        "name": "Ensure residual balance is non-negative",
        "output_column": null,
        "output_file": null,
        "required": true,
        "severity": null,
        "tolerance": null
      },
      {
        "check_id": "valid_open_exposure_gbp",
        "check_type": "formula",
        "formula": "open_exposure_gbp >= 0",
        "input_columns": [
          "open_exposure_gbp"
        ],
        "layer": "row_level",
        "name": "Ensure open exposure in GBP is non-negative",
        "output_column": null,
