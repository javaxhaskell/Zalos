    "output_column_semantics": [
      {
        "allow_empty_string": false,
        "description": "Residual balance after payments, credits, and deductions",
        "fallback_value_semantics": "Use the workflow's explicit default or normalization rule so the derived value is never left blank.",
        "name": "residual_balance",
        "nullable": false,
        "producer_kind": "calculation",
        "required": true,
        "row_semantics": "Emit the derived residual balance for each output row using the contract's calculation or documented row-level logic."
      },
      {
        "allow_empty_string": false,
        "description": "Open exposure converted into GBP",
        "fallback_value_semantics": "Use the workflow's explicit default or normalization rule so the derived value is never left blank.",
        "name": "open_exposure_gbp",
        "nullable": false,
        "producer_kind": "calculation",
        "required": true,
        "row_semantics": "Emit the derived open exposure in GBP for each output row using the contract's calculation or documented row-level logic."
      },
      {
        "allow_empty_string": false,
        "description": "Aging bucket as of 2026-05-01",
        "fallback_value_semantics": "Use the workflow's explicit default or normalization rule so the derived value is never left blank.",
        "name": "aging_bucket",
        "nullable": false,
        "producer_kind": "classification",
        "required": true,
        "row_semantics": "Assign the appropriate aging bucket based on due date relative to 2026-05-01."
      }
    ],
    "calculated_fields": [
      {
        "description": "Residual balance after payments, credits, and deductions",
        "formula": "invoice_amount - paid_amount - credit_note_amount - deduction_amount",
        "name": "residual_balance"
      },
      {
        "description": "Open exposure converted into GBP",
        "formula": "residual_balance",
        "name": "open_exposure_gbp"
      }
    ],
