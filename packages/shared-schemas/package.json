{
  "name": "@agentforge/shared-schemas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./common": "./src/common.ts",
    "./session": "./src/session.ts",
    "./event": "./src/event.ts",
    "./tool": "./src/tool.ts",
    "./workflow": "./src/workflow.ts",
    "./validation": "./src/validation.ts",
    "./artifact": "./src/artifact.ts",
    "./eval": "./src/eval.ts",
    "./generated": "./src/generated.ts"
  },
  "scripts": {
    "gen": "openapi-typescript ../../apps/api/openapi.snapshot.json --output ./src/generated.ts",
    "lint": "echo 'No linting yet — shared types only.' && exit 0",
    "typecheck": "tsc --noEmit",
    "test": "echo 'No tests yet — shared types only.' && exit 0",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.4",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
